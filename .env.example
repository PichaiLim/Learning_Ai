# === AI ===
OLLAMA_API_KEY=""
OLLAMA_MODEL="scb10x/typhoon-ocr1.5-3b"
OLLAMA_BASE_URL_LOCAL = "http://localhost:11434/v1"
OLLAMA_TIMEOUT = 300 # Set Timeout seconds

TYPHOON_OCR_API_KEY=""
TYPHOON_OCR_BASE_URL="https://api.opentyphoon.ai/v1"

chunk_size = 700
overlap = 100

temperature = 0.1
top_p = 0.6
repeat_penalty = 1.1
top_k = 40
max_tokens = 1000


# ===== PostgreSQL =====
# postgresql://user:pass@localhost:5432/dbname
DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=my_database
DB_USER=my_user
DB_PASSWORD=my_password

# (optional) schema / ssl
DB_SCHEMA=public
DB_SSLMODE=prefer

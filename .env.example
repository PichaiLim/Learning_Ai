# ============================================================
# .env.example — Copy เป็น .env แล้วแก้ค่า
# ไฟล์นี้ commit ได้ (ไม่มีค่าจริง), .env ห้าม commit เด็ดขาด
# ============================================================

# ─── Ollama (Local LLM) ────────────────────────────────────
OLLAMA_API_KEY=""
OLLAMA_MODEL="scb10x/typhoon-ocr1.5-3b"
OLLAMA_BASE_URL_LOCAL="http://localhost:11434/v1"
OLLAMA_TIMEOUT=300                          # Timeout (seconds)

# ─── Typhoon OCR API ───────────────────────────────────────
TYPHOON_OCR_API_KEY=""
TYPHOON_OCR_BASE_URL="https://api.opentyphoon.ai/v1"

# ─── LLM API Keys (Optional) ───────────────────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...

# ─── RAG / Chunking Settings ───────────────────────────────
CHUNK_SIZE=700
OVERLAP=100

# ─── LLM Inference Parameters ──────────────────────────────
TEMPERATURE=0.1
TOP_P=0.6
REPEAT_PENALTY=1.1
TOP_K=40
MAX_TOKENS=1000

# ─── Embedding Model ───────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ─── PostgreSQL ────────────────────────────────────────────
# Connection string: postgresql://user:pass@localhost:5432/dbname
DB_ENGINE=postgresql
DB_HOST=db                                  # ใช้ชื่อ service ใน Docker / localhost นอก Docker
DB_PORT=5432
DB_NAME=rag_db
DB_USER=rag_user
DB_PASSWORD=your_strong_password_here

# (Optional) Schema / SSL
DB_SCHEMA=public
DB_SSLMODE=prefer

# ─── pgAdmin (Optional) ────────────────────────────────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=your_pgadmin_password

# ─── Application ───────────────────────────────────────────
APP_ENV=production
DEBUG=false
SECRET_KEY=your_secret_key_here
